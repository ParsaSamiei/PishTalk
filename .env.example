# PostgreSQL connection string (see docs/05_DATABASE.md).
# Neon example: postgresql://user:password@host/db?sslmode=require
DATABASE_URL="postgresql://"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Public site URL, used for metadata, sitemap.xml, and robots.txt
NEXT_PUBLIC_SITE_URL="https://pishtalk.ir"

# Optional. Where support receipt images are written. These are private and
# must NOT live under public/, which is served without authentication.
# Unset means <project root>/private-uploads, which is correct for local dev
# and for the Docker image (where it is a mounted volume).
# PRIVATE_UPLOADS_DIR=""

# FarazSMS (IranPayamak) — sends the registration-approval notice SMS.
# Docs: https://docs.farazsms.com
# API key from the FarazSMS panel (Settings > API).
FARAZSMS_API_KEY=""
# The line number (originator) to send from. If this is a shared line
# rather than a dedicated one, unpatterned sends go through human
# moderation and can take 5-10 minutes to deliver — see lib/sms.ts.
FARAZSMS_LINE_NUMBER=""

# --- Analytics (self-hosted Umami, see docs/10_ANALYTICS.md) ---------------

# Password for Umami's own Postgres database (separate from the app's DB).
UMAMI_DB_PASSWORD=""

# Session-signing secret for the Umami dashboard — generate with:
# openssl rand -base64 32
UMAMI_APP_SECRET=""

# Website ID shown in Umami's dashboard under Settings > Websites, after
# you've logged in and registered pishtalk.ir as a tracked site.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# Where the tracker script itself is served from. Same origin as the site
# since Umami is proxied under /analytics — see docker-compose.yml.
NEXT_PUBLIC_UMAMI_SCRIPT_URL="https://pishtalk.ir/analytics/script.js"