// Prisma schema for Pishtalk.
// Structure follows docs/05_DATABASE.md. Do not rename fields or models
// without updating that document first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
  EDITOR
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ATTENDED
}

enum ResourceType {
  PDF
  PRESENTATION
  GITHUB
  VIDEO
  RESEARCH_PAPER
  EXTERNAL_LINK
}

enum GalleryMediaType {
  IMAGE
  VIDEO
}

enum SupportReceiptStatus {
  PENDING
  APPROVED
  REJECTED
}

model Admin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  avatar       String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  reviewedReceipts      SupportReceipt[]
  reviewedRegistrations Registration[]

  @@map("admins")
}

model Event {
  id          String      @id @default(uuid())
  slug        String      @unique
  title       String
  subtitle    String?
  description String
  coverImage  String?     @map("cover_image")
  date        DateTime    @db.Date
  startTime   String      @map("start_time")
  endTime     String?     @map("end_time")
  location    String
  speakerName String?     @map("speaker_name")
  speakerBio  String?     @map("speaker_bio")
  capacity    Int?
  status      EventStatus @default(DRAFT)

  /// English translations. All nullable: content is authored Persian-first and
  /// the site falls back to the Persian column when these are empty
  /// (see lib/i18n/content.ts).
  titleEn       String? @map("title_en")
  subtitleEn    String? @map("subtitle_en")
  descriptionEn String? @map("description_en")
  locationEn    String? @map("location_en")
  speakerNameEn String? @map("speaker_name_en")
  speakerBioEn  String? @map("speaker_bio_en")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogImage        String? @map("og_image")

  seoTitleEn       String? @map("seo_title_en")
  seoDescriptionEn String? @map("seo_description_en")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  timeline      EventTimelineItem[]
  speakers      EventSpeaker[]
  registrations Registration[]
  resources     Resource[]
  gallery       Gallery?

  @@index([slug])
  @@index([date])
  @@index([status])
  @@map("events")
}

model EventTimelineItem {
  id          String @id @default(uuid())
  eventId     String @map("event_id")
  time        String
  title       String
  description String?
  sortOrder   Int    @default(0) @map("sort_order")

  titleEn       String? @map("title_en")
  descriptionEn String? @map("description_en")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_timelines")
}

/// A speaker (سخنران) presenting at an event. Distinct from the legacy
/// Event.speakerName/speakerBio single-speaker columns, which stay in place
/// unused-but-untouched rather than being migrated, per this file's
/// "do not rename without updating docs/05_DATABASE.md" rule. Up to 3-4 per
/// event, enforced by the form (features/admin/types/eventForm.ts), not the
/// database, so a future need for more never requires a migration.
model EventSpeaker {
  id      String @id @default(uuid())
  eventId String @map("event_id")
  name    String
  bio     String?
  /// Path under /public/uploads/speakers, same convention as Event.coverImage.
  photo   String?
  sortOrder Int  @default(0) @map("sort_order")

  nameEn String? @map("name_en")
  bioEn  String? @map("bio_en")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_speakers")
}

model Registration {
  id         String             @id @default(uuid())
  eventId    String             @map("event_id")
  firstName  String             @map("first_name")
  lastName   String             @map("last_name")
  // Latin-script full name for printing on the certificate of attendance.
  // Required only when firstName/lastName were typed in Persian script;
  // null when firstName/lastName are already Latin (used directly instead).
  certificateName String?       @map("certificate_name")
  phone      String
  email      String?
  university String?
  company    String?
  profession String?
  notes      String?
  status     RegistrationStatus @default(PENDING)

  /// Opaque, unguessable token used in the approval-notice SMS link
  /// (/registration-status/[token]). Generated at submission time — before
  /// any admin has looked at the row — rather than derived from `id`, which
  /// shows up in admin URLs and CSV/Excel exports and so isn't safe to also
  /// use as a bearer credential.
  approvalToken String @unique @default(uuid()) @map("approval_token")

  /// Set together when an admin approves/rejects from /admin/registrations.
  reviewedAt   DateTime? @map("reviewed_at")
  reviewedById String?   @map("reviewed_by_id")
  adminNote    String?   @map("admin_note")

  /// Set once the FarazSMS approval notice is actually accepted by the API.
  /// Null after an APPROVED decision means the send failed; the admin panel
  /// surfaces that so the SMS can be retried instead of failing silently.
  smsSentAt DateTime? @map("sms_sent_at")

  createdAt  DateTime           @default(now()) @map("created_at")

  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reviewedBy Admin? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@map("registrations")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?

  nameEn        String? @map("name_en")
  descriptionEn String? @map("description_en")

  blogs Blog[]

  @@map("categories")
}

model Blog {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String
  coverImage  String?   @map("cover_image")
  categoryId  String?   @map("category_id")
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  readingTime Int?      @map("reading_time")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")

  /// English translations; nullable with Persian fallback.
  titleEn          String? @map("title_en")
  excerptEn        String? @map("excerpt_en")
  contentEn        String? @map("content_en")
  seoTitleEn       String? @map("seo_title_en")
  seoDescriptionEn String? @map("seo_description_en")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([published])
  @@index([categoryId])
  @@index([createdAt])
  @@map("blogs")
}

model Gallery {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  title       String
  description String?
  coverImage  String?  @map("cover_image")

  titleEn       String? @map("title_en")
  descriptionEn String? @map("description_en")
  createdAt   DateTime @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  event Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media GalleryMedia[]

  @@map("galleries")
}

model GalleryMedia {
  id        String           @id @default(uuid())
  galleryId String           @map("gallery_id")
  type      GalleryMediaType @default(IMAGE)
  url       String
  thumbnail String?
  caption   String?
  sortOrder Int              @default(0) @map("sort_order")

  captionEn String? @map("caption_en")

  gallery Gallery @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
  @@map("gallery_media")
}

model Resource {
  id           String       @id @default(uuid())
  eventId      String?      @map("event_id")
  title        String
  description  String?
  resourceType ResourceType @map("resource_type")

  titleEn       String? @map("title_en")
  descriptionEn String? @map("description_en")
  fileUrl      String?      @map("file_url")
  externalUrl  String?      @map("external_url")
  createdAt    DateTime     @default(now()) @map("created_at")
  deletedAt    DateTime?    @map("deleted_at")

  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("resources")
}

model Faq {
  id        String  @id @default(uuid())
  question  String
  answer    String
  sortOrder Int     @default(0) @map("sort_order")
  published Boolean @default(true)

  questionEn String? @map("question_en")
  answerEn   String? @map("answer_en")

  @@map("faqs")
}

model Rule {
  id          String  @id @default(uuid())
  title       String
  description String
  icon        String?
  sortOrder   Int     @default(0) @map("sort_order")
  published   Boolean @default(true)

  titleEn       String? @map("title_en")
  descriptionEn String? @map("description_en")

  @@map("rules")
}

/// Supporters shown on the public /support page (independent of the
/// footer's static SPONSORS list in lib/sponsors.ts, which is unaffected).
/// Managed from /admin/sponsors, per docs/00_AI_INSTRUCTIONS.md's
/// "Future Expansion: Sponsors".
model Sponsor {
  id          String  @id @default(uuid())
  name        String
  /// Path under /public/uploads/sponsors. Optional: a supporter can be
  /// listed by name alone, with no logo uploaded.
  logo        String?
  /// Where the logo/name links out to. Optional: a supporter may not have a site.
  url         String?
  description String?
  sortOrder   Int     @default(0) @map("sort_order")
  published   Boolean @default(true)

  descriptionEn String? @map("description_en")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("sponsors")
}

/// Not listed in docs/05_DATABASE.md's table overview, but the Contact Form
/// component (docs/04_DESIGN_SYSTEM.md) needs somewhere to land submissions
/// until an email provider is wired up. Minimal by design.
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

/// Bank-transfer receipts submitted by anonymous visitors on /support.
/// Bookkeeping only: approving one does NOT create a public Sponsor row.
model SupportReceipt {
  id       String @id @default(uuid())
  fullName String @map("full_name")
  phone    String

  /// Whole Tomans. Int rather than BigInt: BigInt is not JSON-serializable and
  /// leaks awkwardly across the RSC boundary, while the Int ceiling
  /// (~2.1e9 Toman) is far beyond any plausible donation.
  amountToman Int @map("amount_toman")

  /// Bare UUID filename inside the private receipts directory — never a path
  /// or URL, so no value read out of the database can be concatenated into a
  /// traversal. Resolved by lib/receipt-storage.ts.
  receiptFile String @map("receipt_file")

  status       SupportReceiptStatus @default(PENDING)
  adminNote    String?              @map("admin_note")
  reviewedAt   DateTime?            @map("reviewed_at")
  reviewedById String?              @map("reviewed_by_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  reviewedBy Admin? @relation(fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([phone])
  @@map("support_receipts")
}

/// Singleton table: exactly one row should ever exist.
model SiteSettings {
  id               String  @id @default(uuid())
  siteName         String  @default("پیشتاک") @map("site_name")
  tagline          String  @default("جامعه مهندسان رباتیک، هوش مصنوعی و فناوری")
  description      String?

  /// English translations of the visitor-facing settings. Nullable, with
  /// Persian fallback (lib/i18n/content.ts). Non-textual settings (URLs,
  /// analytics ID, maintenance flag) are locale-independent and not duplicated.
  siteNameEn         String? @map("site_name_en")
  taglineEn          String? @map("tagline_en")
  descriptionEn      String? @map("description_en")
  heroTitleEn        String? @map("hero_title_en")
  heroSubtitleEn     String? @map("hero_subtitle_en")
  addressEn          String? @map("address_en")
  copyrightEn        String? @map("copyright_en")
  seoTitleEn         String? @map("seo_title_en")
  seoDescriptionEn   String? @map("seo_description_en")
  logo             String?
  favicon          String?
  heroTitle        String? @map("hero_title")
  heroSubtitle     String? @map("hero_subtitle")
  contactEmail     String? @map("contact_email")
  phone            String?
  phone2           String? @map("phone_2")
  address          String?
  instagram        String?
  telegram         String?
  pishnamUrl       String? @map("pishnam_url")
  googleMapsEmbed  String? @map("google_maps_embed")
  copyright        String?
  seoTitle         String? @map("seo_title")
  seoDescription   String? @map("seo_description")
  defaultOgImage   String? @map("default_og_image")
  /// Not in docs/05_DATABASE.md's field list, but docs/07_ADMIN_PANEL.md's
  /// Site Settings screen explicitly has an "Analytics: Google Analytics"
  /// field. Added as a minimal, optional extension.
  googleAnalyticsId String? @map("google_analytics_id")
  maintenanceMode  Boolean @default(false) @map("maintenance_mode")

  /// Off skips the FarazSMS call in reviewRegistration() (the approval
  /// itself still happens); on sends it automatically. See
  /// features/admin/actions/registrationActions.ts.
  smsApprovalEnabled Boolean @default(true) @map("sms_approval_enabled")

  /// Institute bank details shown on /support so visitors can transfer money
  /// directly. Stored normalized: card number as 16 bare digits, SHEBA as
  /// "IR" + 24 digits, both without separators — grouping is render-only.
  /// `supportPaymentEnabled` defaults to false so the payment block never
  /// renders with blank details on the deploy that introduces these columns.
  supportPaymentEnabled Boolean @default(false) @map("support_payment_enabled")
  supportCardNumber     String? @map("support_card_number")
  supportCardHolder     String? @map("support_card_holder")
  supportSheba          String? @map("support_sheba")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}
